#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$HOME/.local/bin/nix-enter" bash -lc "
  cd $(printf '%q' "$DIR")
  exec nix develop --command bash -lc '
    if [ ! -x ./rt_ocl ]; then
      make fclean >/dev/null
      make >/dev/null
      mv -f rt rt_ocl
    fi
    exec env LD_PRELOAD=\"\$RT_LIBSTDCXX\${LD_PRELOAD:+:\$LD_PRELOAD}\" RT_USE_GPU=1 ./rt_ocl \"\$@\"
  ' -- $(printf '%q ' "$@")
"
